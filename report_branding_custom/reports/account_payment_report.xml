    <template id="report_payment_receipt_custom"
              inherit_id="account.report_payment_receipt_document">

        <xpath expr="." position="replace">

            <t t-call="web.html_container">
                <t t-call="web.external_layout">

                    <t t-foreach="docs" t-as="o">

