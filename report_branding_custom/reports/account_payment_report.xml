                        <!--<td style="width:30%; text-align:right;">-->
                        <!--<img t-if="o.company_id.logo"-->
                        <!--     t-att-src="image_data_uri(o.company_id.logo)"-->
                        <!--     style="max-width:250px; max-height:100px;"/>-->
                        <!--</td>-->

                        <!--</tr>-->
                        <!--</table>-->

                        <!--<hr style="border:0; border-bottom:3px solid #4f055c;"/>-->


                        <!-- TITLE -->

                        <h2 style="text-align:center; color:#7b4775; margin-top:20px;">
                            <b>Payment Receipt</b>
                        </h2>


                        <!-- PAYMENT INFORMATION -->

                        <table style="width:100%; border:1px solid #cfcfcf; margin-top:20px;">

                            <tr>
                                <td style="padding:6px;">
                                    <b>Receipt Number</b>
                                </td>
                                <td style="padding:6px;" t-esc="o.name"/>

                                <td style="padding:6px;">
                                    <b>Payment Date</b>
                                </td>
                                <td style="padding:6px;" t-esc="o.date"/>
                            </tr>

                            <tr>
                                <td style="padding:6px;">
                                    <b>Customer</b>
                                </td>
                                <td style="padding:6px;" t-esc="o.partner_id.name"/>

                                <td style="padding:6px;">
                                    <b>Payment Method</b>
                                </td>
                                <td style="padding:6px;" t-esc="o.payment_method_line_id.name"/>
                            </tr>

                            <tr>
                                <td style="padding:6px;">
                                    <b>Journal</b>
                                </td>
                                <td style="padding:6px;" t-esc="o.journal_id.name"/>

                                <td style="padding:6px;">
                                    <b>Memo</b>
                                </td>
                                <td style="padding:6px;" t-esc="o.memo"/>
                            </tr>

                        </table>


                        <!-- INVOICE PAYMENT LINES -->

                        <table style="width:100%; border-collapse:collapse; margin-top:20px; border:1px solid #cfcfcf;">

                            <thead style="background:#7b4775; color:white;">
                                <tr>

                                    <th style="border:1px solid #cfcfcf;">Invoice</th>
                                    <th style="border:1px solid #cfcfcf;">Invoice Date</th>
                                    <th style="border:1px solid #cfcfcf;">Invoice Total</th>
                                    <th style="border:1px solid #cfcfcf;">Paid Amount</th>

                                </tr>
                            </thead>

                            <tbody>

                                <t t-foreach="o.reconciled_invoice_ids" t-as="inv">

                                    <tr>

                                        <td style="border:1px solid #cfcfcf; padding:5px;" t-esc="inv.name"/>

                                        <td style="border:1px solid #cfcfcf; padding:5px;" t-esc="inv.invoice_date"/>

                                        <td style="border:1px solid #cfcfcf; padding:5px; text-align:right;">
                                            <span t-field="inv.amount_total"
                                                  t-options="{'widget':'monetary','display_currency':inv.currency_id}"/>
                                        </td>

                                        <td style="border:1px solid #cfcfcf; padding:5px; text-align:right;">
                                            <span t-field="o.amount"
                                                  t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                        </td>

                                    </tr>

                                </t>

                            </tbody>

                        </table>


                        <!-- TOTAL -->

                        <table style="width:100%; margin-top:20px;">

                            <tr>

                                <td style="width:60%;">
                                    <b>Amount in Words:</b>
                                    <br/>
                                    <span t-esc="o.currency_id.amount_to_text(o.amount)"/>
                                    Only
                                </td>

                                <td style="width:40%;">

                                    <table style="width:100%; border:1px solid #cfcfcf;">

                                        <tr>
                                            <td style="padding:6px; border:1px solid #cfcfcf;">
                                                <b>Total Paid</b>
                                            </td>

                                            <td style="padding:6px; text-align:right; border:1px solid #cfcfcf;">
                                                <span t-field="o.amount"
                                                      t-options="{'widget':'monetary','display_currency':o.currency_id}"/>
                                            </td>

                                        </tr>

                                    </table>

                                </td>

                            </tr>

                        </table>


                        <!-- SIGNATURES -->

                        <table style="width:100%; margin-top:120px; text-align:center;">

                            <tr>

                                <td style="width:50%; padding:30px;">

                                    <div style="border-top:3px solid #000; width:70%; margin:auto;"></div>

                                    <div style="margin-top:8px; font-weight:bold;">
                                        Accounts Manager
                                    </div>

                                </td>

                                <td style="width:50%; padding:30px;">

                                    <div style="border-top:3px solid #000; width:70%; margin:auto;"></div>

                                    <div style="margin-top:8px; font-weight:bold;">
                                        Authorized Signatory
                                    </div>

                                </td>

                            </tr>

                        </table>


                        <!--<hr style="border:0; border-bottom:3px solid #4f055c; margin-top:20px;"/>-->


                        <!-- FOOTER -->

                        <!--<div style="text-align:center; font-size:13px; color:#666;">-->

