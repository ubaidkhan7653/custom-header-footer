<odoo>
    <record id="group_sale_custom_report" model="res.groups">
        <field name="name">Sale Custom Report Access</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>
    <record id="group_invoice_custom_report" model="res.groups">
        <field name="name">Invoice Custom Report Access</field>
        <field name="category_id" ref="base.module_category_accounting"/>
    </record>


    <record id="paperformat_saleorder_custom" model="report.paperformat">
        <field name="name">Sale Order Custom A4</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">45</field>
        <field name="margin_bottom">25</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
    </record>

    <record id="action_report_saleorder_custom" model="ir.actions.report">
        <field name="name">🛍 Sale/Quotation</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">report_branding_custom.report_saleorder_custom</field>
        <field name="report_file">report_branding_custom.report_saleorder_custom</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Sale/Quotation - %s' % (object.name)</field>

        <!-- 👇 Your custom group -->
        <field name="groups_id" eval="[(4, ref('report_branding_custom.group_sale_custom_report'))]"/>
    </record>


    <record id="action_report_saleorder_confirm_order" model="ir.actions.report">
        <field name="name">🛍 Sale Order Report</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">report_branding_custom.report_saleorder_confirm_oder</field>
        <field name="report_file">report_branding_custom.report_saleorder_confirm_oder</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Sale Order - %s' % (object.name)</field>

        <!-- 👇 Same group -->
        <field name="groups_id" eval="[(4, ref('report_branding_custom.group_sale_custom_report'))]"/>
    </record>

